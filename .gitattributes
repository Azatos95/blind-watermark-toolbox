# 仓库内文本统一使用 LF, 避免 Windows 上被 CRLF 污染
* text=auto eol=lf

# 明确二进制类型, 防止被当文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary

# 前端/脚本语言显式指定
*.py   text eol=lf
*.md   text eol=lf
*.spec text eol=lf
*.ps1  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
